#!/bin/sh
# The far side: any program that prints JSON on stdout.
#
# One object, five datasets, because the demo's subject is the *drawing* and a
# second round trip would only add a spinner to look at. Calcium appends
# `--json` to the argv it spawns; this one has no other format, so it ignores
# every argument — which is the whole contract from Calcium's side.
#
# The numbers are a render profile, which is this repository's own subject: a
# frame budget in milliseconds, split by stage.
cat <<'JSON'
