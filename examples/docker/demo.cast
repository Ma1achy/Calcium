[6.097702, "o", "\u001b[?25l\u001b[17;1H\u001b[0m\u2502\u2502                                                                                                          \u2502\u2502\u001b[18;1H\u001b[0m\u2502\u2502\u001b[38;2;98;98;98mcalcium-ci-probe \u2524\u001b[39m\u001b[48;2;68;1;84m                                                                                        \u001b[49m\u2502\u2502\u001b[19;1H\u001b[0m\u2502\u2502\u001b[38;2;98;98;98m     calcium-dev \u2524\u001b[39m\u001b[48;2;68;1;84m                                                                                        \u001b[49m\u2502\u2502\u001b[20;1H\u001b[0m\u2502\u2502\u001b[38;2;98;98;98m  docker-tui-dev \u2524\u001b[39m\u001b[48;2;68;2;85m                                            \u001b[48;2;68;1;85m                                            \u001b[49m\u2502\u2502\u001b[21;1H\u001b[0m\u2502\u2502\u001b[38;2;98;98;98m        dtui-cfg \u2524\u001b[39m\u001b[48;2;68;1;84m                                                                                        \u001b[49m\u2502\u2502\u001b[22;1H\u001b[0m\u2502\u2502\u001b[38;2;98;98;98m       dtui-load \u2524\u001b[39m\u001b[48;2;68;1;84m                                            \u001b[48;2;253;231;37m                                            \u001b[49m\u2502\u2502\u001b[23;1H\u001b[0m\u001b[0m\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2