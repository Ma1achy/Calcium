                                                            \u001b[39m\u001b[0m\u001b[23;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/ps                                      \u001b[39m  \u001b[38;2;212;212;212m                                                    List containers\u001b[39m\u001b[0m\u001b[24;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/dashboard                               \u001b[39m  \u001b[38;2;212;212;212m                        The running containers, refreshing in place\u001b[39m\u001b[0m\u001b[25;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/clear                                   \u001b[39m  \u001b[38;2;212;212;212m                 empty the transcript; command history is untouched\u001b[39m\u001b[0m\u001b[26;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/top                                     \u001b[39m  \u001b[38;2;212;212;212m                           The processes running inside a container\u001b[39m\u001b[0m\u001b[27;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/port                                    \u001b[39m  \u001b[38;2;212;212;212m                              A container's published port mappings\u001b[39m\u001b[0m\u001b[28;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/help                                    \u001b[39m  \u001b[38;2;212;212;212m                list the verbs; `/help keys` lists the key bindings\u001b[39m\u001b[0m\u001b[29;1H\u001b[0m\u001b[0m+ 37 more                                                                                                     \u001b[0m\u001b[30;1H\u001b[0m\u001b[0m\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u