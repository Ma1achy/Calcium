[52.043497, "o", "\u001b[0 q\u001b[?25l\u001b[1;1H\u001b[0m\u001b[38;2;98;98;98mdocker-tui\u001b[39m  \u001b[38;2;98;98;98m/workspace/examples/docker/bin/docker-json\u001b[39m                                                \u001b[38;2;98;98;98m21:20:40\u001b[39m\u001b[17;1H\u001b[0m\u001b[0m\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\u001b[0m\u001b[18;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/container                               \u001b[39m  \u001b[38;2;212;212;212m                                                                   \u001b[39m\u001b[0m\u001b[19;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/images                                  \u001b[39m  \u001b[38;2;212;212;212m                                          The images on this daemon\u001b[39m\u001b[0m\u001b[20;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/ps                                      \u001b[39m  \u001b[38;2;212;212;212m                                                    List containers\u001b[39m\u001b[0m\u001b[21;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/theme                                   \u001b[39m  \u001b[38;2;212;212;212m                         switch between the dark and light variants\u001b[39m\u001b[0m\u001b[22;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/drift                                   \u001b[39m  \u001b[38;2;212;212;212m      