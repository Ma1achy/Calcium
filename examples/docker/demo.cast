[6.064405, "o", "\u001b[?25l\u001b[H\u001b[38;2;98;98;98mdocker-tui\u001b[39m  \u001b[38;2;98;98;98m/workspaces/tui-kit/examples/docker/bin/docker-json\u001b[39m  \u001b[38;2;98;98;98m21:45:15\u001b[39m                                     \r\r\n                                                                                                              \r\r\n                                                                                                              \r\r\n                                                                                                              \r\r\n                                                                                                              \r\r\n                                                                                                              \r\r\n                                                                                                              \r\r\n                                                                                                              \r\r\n                                                                                                              \r\r\n                                                                                                              \r\r\n                    ##        .                                                                               \r\r\n              ## ## ##       ==              \u2584\u2584\u2584\u2584\u2584                         \u2584\u2584                                 \r\r\n           ## ## ## ##      ===              \u2588\u2588\u2580\u2580\u2580\u2588\u2588                       \u2588\u2588                                 \r\r\n       /\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\\___/ ===            \u2588\u2588    \u2588\u2588   \u2584\u2588\u2588\u2588\u2588\u2584    \u2584\u2588\u2588\u2588\u2588\u2588\u2584  \u2588\u2588 \u2584\u2588\u2588\u2580    \u2584\u2588\u2588\u2588\u2588\u2584    \u2588\u2588\u2584\u2588\