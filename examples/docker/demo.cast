0m\u001b[0m\u001b[38;2;212;212;212m/pause                                                                 \u001b[39m  \u001b[38;2;212;212;212m Suspend every process in a container\u001b[39m\u001b[0m\u001b[27;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/prune                                                                 \u001b[39m  \u001b[38;2;212;212;212m            Remove stopped containers\u001b[39m\u001b[0m\u001b[28;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/pull                                                                  \u001b[39m  \u001b[38;2;212;212;212m                    Download an image\u001b[39m\u001b[0m\u001b[29;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/push                                                                  \u001b[39m  \u001b[38;2;212;212;212m      Upload an image to its registry\u001b[39m\u001b[0m\u001b[32;1H\u001b[0m\u276f /p                                                                                                          \u001b[?25l\u001b[32;5H\u001b[?25h"]
