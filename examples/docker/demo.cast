[52.069847, "o", "\u001b[0 q\u001b[?25l\u001b[1;1H\u001b[0m\u001b[38;2;98;98;98mdocker-tui\u001b[39m  \u001b[38;2;98;98;98m/workspace/examples/docker/bin/docker-json\u001b[39m                                                \u001b[38;2;98;98;98m02:31:56\u001b[39m\u001b[17;1H\u001b[0m\u001b[0m\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\u001b[0m\u001b[18;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/container                               \u001b[39m  \u001b[38;2;212;212;212m                                                                   \u001b[39m\u001b[0m\u001b[19;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/images                                  \u001b[39m  \u001b[38;2;212;212;212m                                          The images on this daemon\u001b[39m\u001b[0m\u001b[20;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/ps                                      \u001b[39m  \u001b[38;2;212;212;212m                                                    List containers\u001b[39m\u001b[0m\u001b[21;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/theme                                   \u001b[39m  \u001b[38;2;212;212;212m                         switch between the dark and light variants\u001b[39m\u001b[0m\u001b[22;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/drift                                   \u001b[39m  \u001b[38;2;212;212;212m                What a running container has changed from its image\u001b[39m\u001b[0m\u001b[23;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/config                                  \u001b[39m  \u001b[38;2;212;212;212mA config file as the container has it, against the image's original\u001b[39m\u001b[0m\u001b[24;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/dashboard                               \u001b[39m  \u001b[38;2;212;212;212m                        The running containers, refreshing in place\u001b[39m\u001b[0m\u001b[25;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/clear                                   \u001b[39m  \u001b[38;2;212;212;212m                 empty the transcript; command history is untouched\u001b[39m\u001b[0m\u001b[26;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/top                                     \u001b[39m  \u001b[38;2;212;212;212m                           The processes running inside a container\u001b[39m\u001b[0m\u001b[27;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/port                                    \u001b[39m  \u001b[38;2;212;212;212m                              A container's published port mappings\u001b[39m\u001b[0m\u001b[28;1H\u001b[0m\u001b[0m\u001b[38;2;212;212;212m/help                                    \u001b[39m  \u001b[38;2;212;212;212m                list the verbs; `/help keys` lists the key bindings\u001b[39m\u001b[0m\u001b[29;1H\u001b[0m\u001b[0m+ 37 more                                                                                                     \u001b[0m\u001b[30;1H\u001b[0m\u001b[0m\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\