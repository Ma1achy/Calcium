2580\u2580\u2580\u2580    \u2580\u2580            \r\r\n                                                                                                              \r\r\n\u001b[38;2;138;138;138m\u250c\u001b[38;2;232;168;124m docker-tui \u00b7 engine 29.4.1 \u00b7 10 containers \u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[39m\r\r\n\u001b[38;2;138;138;138m\u2502\u250c\u001b[38;2;232;168;124m RUNNING \u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u2502\u001b[39m\r\r\n\u2502\u001b[38;2;138;138;138m\u2502\u001b[38;2;98;98;98m4 running   CPU 109% \u00b7 MEM 4%\u001b[39m                                                                             \u001b[38;2;138;138;138m\u2502\u001b[39m\u2502\r\r\n\u2502\u2502                                                                                                          \u2502\u2502\r\r\n\u2502\u2502\u001b[38;2;98;98;98mNAME                    \u001b[39m  \u001b[38;2;98;98;98mCPU              \u001b[39m  \u001b[38;2;98;98;98mMEM              \u001b[39m  \u001b[38;2;98;98;98mUSAGE             \u001b[39m                        \u2502\u2502\r\r\n\u2502\u2502\u001b[38;2;135;184;108m\u25cf dtui-cfg              \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.0%    \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.1%    \u001b[39m  \u001b[38;2;212;212;212m9.379MiB / 7.75GiB\u001b[39m                        \u2502\u2502\r\r\n\u2502\u2502\u001b[38;2;135;184;108m\u25cf dtui-load             \u001b[39m  \u001b[38;2;212;120;103m\u25b2 \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588 106.9%\u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.1%    \u001b[39m  \u001b[38;2;212;212;212m11.37MiB / 7.75GiB\u001b[39m                        \u2502\u2502\r\r\n\u001b[0m\u001b[38;2;212;212;212m/ps                                      \u001b[39m  \u001b[38;2;212;212;212m                                                    List containers\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/dashboard                               \u001b[39m  \u001b[38;2;212;212;212m                        The running containers, refreshing in place\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/container                               \u001b[39m  \u001b[38;2;212;212;212m                                                                   \u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/inspect                                 \u001b[39m  \u001b[38;2;212;212;212m                One container in full \u2014 structured, or the raw JSON\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/logs                                    \u001b[39m  \u001b[38;2;212;212;212m                                        Follow a container's output\u001b[39m\u001b[0m\r\r\n"]
[16.473819, "o", "\u001b[0m\u001b[38;2;212;212;212m/drift                                   \u001b[39m  \u001b[38;2;212;212;212m                What a running container has changed from its image\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/compare                                 \u001b[39m  \u001b[38;2;212;212;212m                                       Two containers, side by side\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/config                                  \u001b[39m  \u001b[38;2;212;212;212mA config file as the container has it, against the image's original\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/diff                                    \u001b[39m  \u001b[38;2;212;212;212m                 What a container has changed on its own filesystem\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/images                                  \u001b[39m  \u001b[38;2;212;212;212m                                          The images on this daemon\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/top                                     \u001b[39m  \u001b[38;2;212;212;212m                           The processes running inside a container\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/port                                    \u001b[39m  \u001b[38;2;212;212;212m                              A container's published port mappings\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/events                                  \u001b[39m  \u001b[38;2;212;212;212m                           Container lifecycle events, newest first\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/help                                    \u001b[39m  \u001b[38;2;212;212;212m                                        list verbs and key bindings\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/clear                                   \u001b[39m  \u001b[38;2;212;212;212m                 empty the transcript; command history is untouched\u001b[39m\u001b[0m\r\r\n\u276f /                                                                                                           \r\r\n                                                                                                              \u001b[?25l\u001b[33;4H\u001b[?25h"]
