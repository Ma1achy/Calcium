m  \u001b[38;2;212;212;212m                                             List containers\u001b[39m\u001b[0m\u001b[38;2;140;140;140m\u001b[38;2;212;179;90m\u001b[39m \u001b[0m\u001b[23;1H\u001b[0m\u001b[0m  \u001b[38;2;212;212;212m/port                                        \u001b[39m  \u001b[38;2;212;212;212m                       A container's published port mappings\u001b[39m\u001b[0m\u001b[38;2;140;140;140m\u001b[39m \u001b[0m\u001b[24;1H\u001b[0m\u001b[0m  \u001b[38;2;212;212;212m/pause                                       \u001b[39m  \u001b[38;2;212;212;212m                        Suspend every process in a container\u001b[39m\u001b[0m\u001b[38;2;140;140;140m\u001b[39m\u001b[48;2;68;1;84m\u001b[48;2;70;50;126m\u001b[48;2;54;92;141m\u001b[48;2;39;127;142m\u001b[48;2;31;161;135m\u001b[48;2;74;193;109m\u001b[48;2;159;218;58m\u001b[48;2;253;231;37m\u001b[49m\u001b[38;2;140;140;140m\u001b[39m \u001b[0m\u001b[25;1H\u001b[0m\u001b[0m  \u001b[38;2;212;212;212m/prune                                       \u001b[39m  \u001b[38;2;212;212;212m                                   Remove stopped containers\u001b[39m\u001b[0m\u001b[38;2;138;138;138m\u001b[39m \u001b[0m\u001b[26;1H\u001b[0m\u001b[0m  \u001b[38;2;212;212;212m/pull                                        \u001b[39m  \u001b[38;2;212;212;212m                                           Download an image\u001b[39m\u001b[0m \u001b[27;1H\u001b[0m\u001b[0m  \u001b[38;2;212;212;212m/push                                        \u001b[39m  \u001b[38;2;212;212;212m                             Upload an image to its registry\u001b[39m\u001b[0m\u001b[38;2;140;140;140m\u001b[39m \u001b[0m\u001b[28;1H\u001b[0m\u001b[0m  \u001b[38;2;212;212;212m/profile                                     \u001b[39m  \u001b[38;2;212;212;212mopen the profiler's deck; also `snapshot`, `live`, `capture`\u001b[39m\u001b[0m\u001b[38;2;138;138;138m\u001b[39m \u001b[0m\u001b[31;1H\u001b[0m\u276f /p                                                         