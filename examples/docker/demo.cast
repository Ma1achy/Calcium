[6.203765, "o", "\u001b[6 q\u001b[?25l\u001b[23;1H\u001b[0m\u2502\u2502\u001b[38;2;98;98;98m                 \u2502\u001b[38;2;212;179;90m+2 more \u00b7 60d028f3a95d \u00b7 dtui-web\u001b[39m                                                       \u2502\u2502\u001b[24;1H\u001b[0m\u2502\u2502                  \u001b[38;2;98;98;98m-2 ticks                                                                             now\u001b[39m\u2502\u2502\u001b[25;1H\u001b[0m\u2502\u2502\u001b[38;2;98;98;98m0% \u001b[39m\u001b[48;2;68;1;84m \u001b[48;2;70;50;126m \u001b[48;2;54;92;141m \u001b[48;2;39;127;142m \u001b[48;2;31;161;135m \u001b[48;2;74;193;109m \u001b[48;2;159;218;58m \u001b[48;2;253;231;37m \u001b[49m\u001b[38;2;98;98;98m 108%\u001b[39m                                                                                          \u2502\u2502\u001b[26;1H\u001b[0m\u2502\u001b[38;2;138;138;138m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[39m\u2502\u001b[27;1H\u001b[0m\u2502                                                                                                            \u2502\u001b[28;1H\u001b[0m\u2502\u001b[38;2;98;98;98mdtui-quiet\u001b[39m                                                                                                  \u2502\u001b[29;1H\u001b[0m\u001b[38;2;138;138;138m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\