[70.607626, "o", "\u001b[?25l\u001b[1;1H\u001b[0m\u001b[38;2;98;98;98mdocker-tui\u001b[39m  \u001b[38;2;98;98;98m/workspace/examples/docker/bin/docker-json\u001b[39m                                                \u001b[38;2;98;98;98m21:20:58\u001b[39m\u001b[3;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m21\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m \u001b[38;2;212;212;212m    # proxy the PHP scripts to Apache listening on 127.0.0.1:80\u001b[39m                                   \u001b[49m\u001b[4;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m22\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m \u001b[38;2;212;212;212m    #\u001b[39m                                                                                             \u001b[49m\u001b[5;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m23\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m \u001b[38;2;212;212;212m    #location ~ \\.php$ {\u001b[39m                                                                          \u001b[49m\u001b[6;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m24\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m \u001b[38;2;212;212;212m    #    proxy_pass   http://127.0.0.1;\u001b[39m                                                           \u001b[49m\u001b[7;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m25\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m \u001b[38;2;212;212;212m    #}\u001b[39m                                                                                            \u001b[49m\u001b[8;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m26\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m                                                                                                   \u001b[49m\u001b[9;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m27\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m \u001b[38;2;212;212;212m    # pass the PHP scripts to FastCGI server listening on 127.0.0.1:9000\u001b[39m                          \u001b[49m\u001b[10;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m28\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m \u001b[38;2;212;212;212m    #\u001b[39m                                                                                             \u001b[49m\u001b[11;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m29\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m \u001b[38;2;212;212;212m    #location ~ \\.php$ {\u001b[39m                                                                          \u001b[49m\u001b[12;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m30\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m \u001b[38;2;212;212;212m    #    root           html;\u001b[39m                                                                     \u001b[49m\u001b[13;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m31\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m \u001b[38;2;212;212;212m    #    fastcgi_pass   127.0.0.1:9000;\u001b[39m                                                           \u001b[49m\u001b[14;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m32\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m \u001b[38;2;212;212;212m    #    fastcgi_index  index.php;\u001b[39m                                                                \u001b[49m\u001b[15;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m33\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m \u001b[38;2;212;212;212m    #    fastcgi_param  SCRIPT_FILENAME  /scripts$fastcgi_script_name;\u001b[39m                            \u001b[49m\u001b[16;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m34\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m \u001b[38;2;212;212;212m    #    include        fastcgi_params;\u001b[39m                                                           \u001b[49m\u001b[17;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m35\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m \u001b[38;2;212;212;212m    #}\u001b[39m                                                                                            \u001b[49m\u001b[18;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m36\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m                                                                                                   \u001b[49m\u001b[19;1H\u001b[0m    \u001b[38;2;98;98;98m37\u001b[39m \u001b[38;2;98;98;98m32\u001b[39m \u001b[38;2;98;98;98m \u001b[39m \u001b[38;2;212;212;212m    # deny access to .htaccess files, if Apache's document root\u001b[39m                                   \u001b[20;1H\u001b[0m    \u001b[38;2;98;98;98m38\u001b[39m \u001b[38;2;98;98;98m33\u001b[39m \u001b[38;2;98;"]
[70.611118, "o", "98;98m \u001b[39m \u001b[38;2;212;212;212m    # concurs with nginx's one\u001b[39m                                                                    \u001b[21;1H\u001b[0m    \u001b[38;2;98;98;98m39\u001b[39m \u001b[38;2;98;98;98m34\u001b[39m \u001b[38;2;98;98;98m \u001b[39m \u001b[38;2;212;212;212m    #\u001b[39m                                                                                             \u001b[22;1H\u001b[0m    \u22ef 1 unchanged line                                                                                        \u001b[23;1H\u001b[0m    @@ -41 +36 @@                                                                                             \u001b[24;1H\u001b[0m    \u001b[38;2;98;98;98m41\u001b[39m \u001b[38;2;98;98;98m36\u001b[39m \u001b[38;2;98;98;98m \u001b[39m \u001b[38;2;212;212;212m    #    deny  all;\u001b[39m                                                                               \u001b[25;1H\u001b[0m    \u001b[38;2;98;98;98m42\u001b[39m \u001b[38;2;98;98;98m37\u001b[39m \u001b[38;2;98;98;98m \u001b[39m \u001b[38;2;212;212;212m    #}\u001b[39m                                                                                            \u001b[26;1H\u001b[0m    \u001b[38;2;98;98;98m43\u001b[39m \u001b[38;2;98;98;98m38\u001b[39m \u001b[38;2;98;98;98m \u001b[39m \u001b[38;2;212;212;212m}\u001b[39m                                                                                                 \u001b[27;1H\u001b[0m    \u001b[38;2;198;40;40m\u001b[48;2;73;0;0m44\u001b[39m \u001b[38;2;198;40;40m  \u001b[39m \u001b[38;2;198;40;40m-\u001b[39m                                                                                                   \u001b[49m\u001b[28;1H\u001b[0m                                                                                                              \u001b[29;1H\u001b[0m    \u001b[38;2;98;98;98m3 hunks \u00b7 +14 -20\u001b[39m                                                                    