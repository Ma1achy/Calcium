[34.664997, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;138;138;138m\u2502\u001b[39m                                                                                                            \u001b[38;2;138;138;138m\u2502\u001b[39m\u001b[0m\r\r\n\u001b[0m\u2502\u001b[38;2;98;98;98mMEM \u001b[39m  \u001b[38;2;212;212;212m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.2%    15.13MiB / 7.75GiB\u001b[39m                                                                   \u2502\u001b[0m\r\r\n\u001b[0m\u2502\u001b[38;2;98;98;98mNET \u001b[39m  \u001b[38;2;212;212;212m1.17kB / 126B\u001b[39m                                                                                         \u2502\u001b[0m\r\r\n\u001b[0m\u2502\u001b[38;2;98;98;98mBLK \u001b[39m  \u001b[38;2;212;212;212m0B / 0B\u001b[39m                                                                                               \u2502\u001b[0m\r\r\n\u001b[0m\u2502\u001b[38;2;98;98;98mPIDS\u001b[39m  \u001b[38;2;212;212;212m2\u001b[39m                                                                                                     \u2502\u001b[0m\r\r\n\u001b[0m\u001b[38;2;138;138;138m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u