               \u001b[39m  \u001b[38;2;212;212;212m                        The running containers, refreshing in place\u001b[39m\u001b[0m \u001b[22;1H\u001b[0m\u001b[0m  \u001b[38;2;212;212;212m/inspect                              \u001b[39m  \u001b[38;2;212;212;212m                One container in full \u2014 structured, or the raw JSON\u001b[39m\u001b[0m\u001b[38;2;138;138;138m\u001b[38;2;232;168;124m\u001b[38;2;138;138;138m\u001b[39m \u001b[0m\u001b[23;1H\u001b[0m\u001b[0m  \u001b[38;2;212;212;212m/logs                                 \u001b[39m  \u001b[38;2;212;212;212m                                        Follow a container's output\u001b[39m\u001b[0m\u001b[38;2;138;138;138m\u001b[39m\u001b[38;2;138;138;138m\u001b[39m \u001b[0m\u001b[24;1H\u001b[0m\u001b[0m  \u001b[38;2;212;212;212m/drift                                \u001b[39m  \u001b[38;2;212;212;212m                What a running container has changed from its image\u001b[39m\u001b[0m\u001b[38;2;140;140;140m\u001b[39m\u001b[38;2;212;212;212m\u001b[39m \u001b[0m\u001b[25;1H\u001b[0m\u001b[0m  \u001b[38;2;212;212;212m/compare                              \u001b[39m  \u001b[38;2;212;212;212m                                       Two containers, side by side\u001b[39m\u001b[0m\u001b[38;2;140;140;140m\u001b[39m\u001b[38;2;212;212;212m\u001b[39m \u001b[0m\u001b[26;1H\u001b[0m\u001b[0m  \u001b[38;2;212;212;212m/filediff                             \u001b[39m  \u001b[38;2;212;212;212mA config file as the container has it, against the image's original\u001b[39m\u001b[0m\u001b[38;2;140;140;140m\u001b[39m\u001b[38;2;212;212;212m\u001b[39m \u001b[0m\u001b[27;1H\u001b[0m\u001b[0m  \u001b[38;2;212;212;212m/diff                                 \u001b[39m  \u001b[38;2;212;212;212m                 What a container has changed on its own filesystem\u001b[39m\u001b[0m\u001b[38;2;140;140;140m\u001b[39m\u001b[38;2;212;212;212m\u001b[39m \u001b[0m\u001b[28;1H\u001b[0m\u001b[0m+ 43 more                                        