[89.231272, "o", "\u001b[?25l\u001b[1;1H\u001b[0m\u001b[38;2;98;98;98mdocker-tui\u001b[39m  \u001b[38;2;98;98;98m/workspace/examples/docker/bin/docker-json\u001b[39m                                                \u001b[38;2;98;98;98m02:32:33\u001b[39m\u001b[3;1H\u001b[0m\u276f /drift dtui-web                                                                                             \u001b[4;1H\u001b[0m\u001b[38;2;127;174;207m\u2b24 drift(dtui-web)\u001b[39m                                                                                             \u001b[5;1H\u001b[0m  \u001b[38;2;98;98;98m\u23bf\u001b[0m   \u001b[38;2;138;138;138mfield                             \u001b[39m  \u001b[38;2;138;138;138mnginx:alpine                     \u001b[39m  \u001b[38;2;138;138;138mdtui-web                         \u001b[39m\u001b[6;1H\u001b[0m  \u001b[38;2;98;98;98m\u2502\u001b[0m \u001b[38;2;98;98;98m  entrypoint                        \u001b[39m  \u001b[38;2;212;212;212m/docker-entrypoint.sh            \u001b[39m  \u001b[38;2;212;212;212m/docker-entrypoint.sh            \u001b[39m\u001b[7;1H\u001b[0m  \u001b[38;2;98;98;98m\u2502\u001b[0m \u001b[38;2;98;98;98m  cmd                               \u001b[39m  \u001b[38;2;212;212;212mnginx -g daemon off;             \u001b[39m  \u001b[38;2;212;212;212mnginx -g daemon off;             \u001b[39m\u001b[8;1H\u001b[0m  \u001b[38;2;98;98;98m\u2502\u001b[0m \u001b[38;2;98;98;98m  workdir                           \u001b[39m  \u001b[38;2;212;212;212m/                                \u001b[39m  \u001b[38;2;212;212;212m/                                \u001b[39m\u001b[9;1H\u001b[0m  \u001b[38;2;98;98;98m\u2502\u001b[0m \u001b[38;2;98;98;98m  stop signal                       \u001b[39m  \u001b[38;2;212;212;212mSIGQUIT                          \u001b[39m  \u001b[38;2;212;212;212mSIGQUIT                          \u001b[39m\u001b[10;1H\u001b[0m  \u001b[38;2;98;98;98m\u2502\u001b[0m \u001b[38;2;98;98;98m~ ports 80/tcp                      \u00