2;212m/container                               \u001b[39m  \u001b[38;2;212;212;212m                                                                   \u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/inspect                                 \u001b[39m  \u001b[38;2;212;212;212m                One container in full \u2014 structured, or the raw JSON\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/logs                                    \u001b[39m  \u001b[38;2;212;212;212m                                        Follow a container's output\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/drift                                   \u001b[39m  \u001b[38;2;212;212;212m                What a running container has changed from its image\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/compare                                 \u001b[39m  \u001b[38;2;212;212;212m                                       Two containers, side by side\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/config                                  \u001b[39m  \u001b[38;2;212;212;212mA config file as the container has it, against the image's original\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/diff                                    \u001b[39m  \u001b[38;2;212;212;212m "]
[6.064416, "o", "                What a container has changed on its own filesystem\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/images                                  \u001b[39m  \u001b[38;2;212;212;212m                                          The images on this daemon\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/top                                     \u001b[39m  \u001b[38;2;212;212;212m                           The processes running inside a container\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/port                                    \u001b[39m  \u001b[38;2;212;212;212m                              A container's published port mappings\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/events                                  \u001b[39m  \u001b[38;2;212;212;212m                           Container lifecycle events, newest first\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/help                                    \u001b[39m  \u001b[38;2;212;212;212m                                        list verbs and key bindings\u001b[39m\u001b[0m\r\r\n\u276f /                                                                                                           \r\r\n                                                                                                              \u001b[?25l\u001b[33;4H\u001b[?25h"]
