[21.411571, "o", "\u2518\u001b[39m\u2502\r\r\n\u2502                                                                                                            \u2502\r\r\n\u2502\u001b[38;2;98;98;98mbeautiful_booth\u001b[39m  \u001b[38;2;98;98;98mcondescending_cohen\u001b[39m  \u001b[38;2;98;98;98mdazzling_wozniak\u001b[39m  \u001b[38;2;98;98;98mdistracted_davinci\u001b[39m  \u001b[38;2;98;98;98mdtui-quiet\u001b[39m  \u001b[38;2;98;98;98mfrosty_hodgkin\u001b[39m      \u2502\r\r\n\u001b[38;2;138;138;138m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[39m\r\r\n\u276f /ps                                                                                                         \r\r\n                                                                                                              \r\r\n\u001b[38;2;98;98;98mNAME            \u001b[39m  \u001b[38;2;98;98;98mIMAGE               \u001b[39m  \u001b[38;2;98;98;98mSTATUS                  \u001b[39m  \u001b[38;2;98;98;98mPORTS                                       \u001b[39m\r\r\n\u001b[38;2;127;184;184mdtui-load       \u001b[39m  \u001b[38;2;212;212;212malpine              \u001b[39m  \u001b[38;2;135;184;108m\u25cf Up 4 minutes          \u001b[39m  \u001b[38;2;98;98;98m\u2014                                           \u001b[39m\r\r\n\u001b[38;2;127;184;184mdtui-cfg        \u001b[39m  \u001b[38;2;212;212;212mnginx:alpine        \u001b[39m  \u001b[38;2;135;184;108m\u25cf Up 4 minutes          \u001b[39m  \u001b[38;2;212;212;212m80/tcp                                      \u001b[39m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/container                               \u001b[39m  \u001b[38;2;212;212;212m                                                                   \u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m/compare                                 \u001b[39m  \u001b[38;2;212;212;212m                                       Two containers, side by side\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;212;212;212m\u2022 /config                                \u001b[39m  \u001b[38;2;212;212;212mA config file as the container has it, against the image's original\u001b[39m\u001b[0m\r\r\n\u001b[0m\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\u001b[0m\r\r\n\u276f /co                                                                                                         \r\r\n                                                                                                              \u001b[?25l"]
