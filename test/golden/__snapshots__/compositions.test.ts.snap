exports[`C10 §4k — the compositions, as frames > case 6 — stale + running, at 1-bit 1`] = `
"-- the frame
  ┌ ⠋ workers ────────────────── updated 4m ago ─┐
  │● pytest(tests/unit) · ⠋ 4s                   │
  └──────────────────────────────────────────────┘

-- which fact took the ground, run by run
  dim/-:"┌" bold/-:" ⠋ workers " dim/-:"──────────────────" bold/-:" updated 4m ago " dim/-:"─┐"
  dim/-:"│● pytest(tests/unit) · ⠋ 4s" dim/-:"│"
  dim/-:"└──────────────────────────────────────────────┘"

-- without freshness, run by run
  dim/-:"┌" bold/-:" ⠋ workers " dim/-:"───────────────────────────────────┐"
  dim/-:"│" page/-:"● pytest(tests/unit) · ⠋ 4s                   " dim/-:"│"
  dim/-:"└──────────────────────────────────────────────┘"

-- without liveness, run by run
  dim/-:"┌" bold/-:" ⠋ workers " dim/-:"──────────────────" bold/-:" updated 4m ago " dim/-:"─┐"
  dim/-:"│✓ pytest(tests/unit) · 4s · 47 passed" dim/-:"│"
  dim/-:"└──────────────────────────────────────────────┘"

-- the ruling (C10 §4k.2 row 6)
  nothing is contested · staleness dims the content and names its age · the spinner keeps the duration slot"
`;

