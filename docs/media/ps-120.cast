                       \r\r\n                                                                                                                        \r\r\n                                                                                                                        \r\r\n                                                                                                                        \r\r\n                                                                                                                        \r\r\n                                                                                                                        \r\r\n                                                                                                                        \r\r\n                                                                                                                        \r\r\n                                                                                                                        \r\r\n                    ##        .                                                                                         \r\r\n              ## ## ##       ==              \u2584\u2584\u2584\u2584\u2584                         \u2584\u2584                                           \r\r\n           ## ## ## ##      ===              \u2588\u2588\u2580\u2580\u2580\u2588\u2588                       \u2588\u2588                                           \r\r\n       /\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\\___/ ===            \u2588\u2588    \u2588\u2588   \u2584\u2588\u2588\u2588\u2588\u2584    \u2584\u2588\u2588\u2588\u2588\u2588\u2584  \u2588\u2588 \u2584\u2588\u2588\u2580    \u2584\u2588\u2588\u2588\u2588\u2584    \u2588\u2588\u2584\u2588\u2588\u2588\u2588                 \r\r\n  ~~~ {~~ ~~~~ ~~~ ~~~~ ~~ ~ /  ===- ~~~     \u2588\u2588    \u2588\u2588  \u2588\u2588\u2580  \u2580\u2588\u2588  \u2588\u2588\u2580    \u2580  \u2588\u2588\u2584\u2588\u2588     \u2588\u2588\u2584\u2584\u2584\u2584\u2588\u2588   \u2588\u2588\u2580                     \r\r\n       \\______ o          __/                \u2588\u2588    \u2588\u2588  \u2588\u2588    \u2588\u2588  \u2588\u2588        \u2588\u2588\u2580\u2588\u2588\u2584    \u2588\u2588\u2580\u2580\u2580\u2580\u2580\u2580   \u2588\u2588                      \r\r\n         \\    \\        __/                   \u2588\u2588\u2584\u2584\u2584\u2588\u2588   \u2580\u2588\u2588\u2584\u2584\u2588\u2588\u2580  \u2580\u2588\u2588\u2584\u2584\u2584\u2584\u2588  \u2588\u2588  \u2580\u2588\u2584   \u2580\u2588\u2588\u2584\u2584\u2584\u2584\u2588   \u2588\u2588                      \r\r\n          \\____\\______/                      \u2580\u2580\u2580\u2580\u2580       \u2580\u2580\u2580\u2580      \u2580\u2580\u2580\u2580\u2580   \u2580\u2580   \u2580\u2580\u2580    \u2580\u2580\u2580\u2580\u2580    \u2580\u2580                      \r\r\n                                                                                                                        \r\r\n\u001b[38;2;138;138;138m\u250c\u001b[38;2;232;168;124m docker-tui \u00b7 engine 29.4.1 \u00b7 10 containers \u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[39m\r\r\n\u001b[38;2;138;138;138m\u2502\u001b[39m                                                                                                                      \u001b[38;2;138;138;138m\u2502\u001b[39m\r\r\n\u2502\u001b[38;2;138;138;138m\u250c\u001b[38;2;232;168;124m RUNNING \u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25