500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[39m\u2502\r\r\n\u2502\u001b[38;5;244m\u2502\u001b[38;5;241m4 running   CPU 65% \u00b7 MEM 3%\u001b[39m                                                                    \u001b[38;5;244m\u2502\u001b[39m\u2502\r\r\n\u2502\u2502                                                                                                \u2502\u2502\r\r\n\u2502\u2502\u001b[38;5;241mNAME                    \u001b[39m  \u001b[38;5;241mCPU              \u001b[39m  \u001b[38;5;241mMEM              \u001b[39m  \u001b[38;5;241mUSAGE             \u001b[39m              \u2502\u2502\r\r\n\u2502\u2502\u001b[38;5;107m\u25cf dtui-cfg              \u001b[39m  \u001b[38;5;107m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.0%    \u001b[39m  \u001b[38;5;107m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.1%    \u001b[39m  \u001b[38;5;188m9.395MiB / 7.75GiB\u001b[39m              \u2502\u2502\r\r\n\u2502\u2502\u001b[38;5;107m\u25cf dtui-load             \u001b[39m  \u001b[38;5;179m\u25b2 \u2588\u2588\u2588\u2588\u2588\u2591\u2591\u2591 63.7% \u001b[39m  \u001b[38;5;107m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.0%    \u001b[39m  \u001b[38;5;188m1.395MiB / 7.75GiB\u001b[39m              \u2502\u2502\r\r\n\u2502\u2502\u001b[38;5;107m\u25cf dtui-web              \u001b[39m  \u001b[38;5;107m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.0%    \u001b[39m  \u001b[38;5;107m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.1%    \u001b[39m  \u001b[38;5;188m9.391MiB / 7.75GiB\u001b[39m              \u2502\u2502\r\r\n\u2502\u2502\u001b[38;5;107m\u25cf reverent_proskuriakova\u001b[39m  \u001b[38;5;107m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 1.3%    \u001b[39m  \u001b[38;5;107m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 3.0%    \u001b[39m  \u001b[38;5;188m237.9MiB / 7.75GiB\u001b[39m              \u2502\u2502\r\r\