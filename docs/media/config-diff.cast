                                                                                      \r\r\n\u2500\u2500 /etc/nginx/conf.d/default.conf \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n@@ -1 +1 @@                                                                                                             \r\r\n\u001b[38;2;98;98;98m 1\u001b[39m \u001b[38;2;98;98;98m 1\u001b[39m \u001b[38;2;98;98;98m \u001b[39m \u001b[38;2;212;212;212mserver {\u001b[39m                                                                                                        \r\r\n\u001b[38;2;212;120;103m\u001b[48;2;73;0;0m 2\u001b[39m \u001b[38;2;212;120;103m  \u001b[39m \u001b[38;2;212;120;103m-\u001b[39m \u001b[38;2;212;212;212m    listen       80;\u001b[39m                                                                                            \u001b[49m\r\r\n\u001b[38;2;212;120;103m\u001b[48;2;73;0;0m 3\u001b[39m \u001b[38;2;212;120;103m  \u001b[39m \u001b[38;2;212;120;103m-\u001b[39m \u001b[38;2;212;212;212m    server_name  localhost;\u001b[39m                                                                                     \u001b[49m\r\r\n\u001b[38;2;135;184;108m\u001b[48;2;0;38;0m  \u001b[39m \u001b[38;2;135;184;108m 2\u001b[39m \u001b[38;2;135;184;108m+\u001b[39m \u001b[38;2;212;212;212m    listen       8080;\u001b[39m                                                                                          \u001b[49m\r\r\n\u001b[38;2;135;184;108m\u001b[48;2;0;38;0m  \u001b[39m \u001b[38;2;135;184;108m 3\u001b[3