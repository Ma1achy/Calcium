00\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[38;2;138;138;138m\u2502\u001b[39m\u001b[0m\u001b[38;2;98;98;98m\u001b[39m\u001b[48;2;68;1;84m\u001b[48;2;70;50;126m\u001b[48;2;54;92;141m\u001b[48;2;39;127;142m\u001b[48;2;31;161;135m\u001b[48;2;74;193;109m\u001b[48;2;159;218;58m\u001b[48;2;253;231;37m\u001b[49m\u001b[38;2;98;98;98m\u001b[39m\u001b[38;2;98;98;98m\u001b[38;2;240;228;66m\u001b[38;2;98;98;98m\u001b[39m \u001b[0m\u001b[7;1H\u001b[0m\u001b[0m\u2502\u001b[38;2;98;98;98m   visible \u2524\u001b[38;2;230;159;0m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588                                            \u001b[38;2;98;98;98m\u2502\u001b[39m\u2502\u001b[0m\u001b[38;2;98;98;98m\u001b[38;2;240;228;66m\u001b[38;2;98;98;98m\u001b[39m \u001b[0m\u001b[8;1H\u001b[0m\u001b[0m\u2502\u001b[38;2;98;98;98m      rows \u2524\u001b[38;2;86;180;233m                                       \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588              \u001b[38;2;98;98;98m\u2502\u001b[39m\u2502\u001b[0m\u001b[38;2;98;98;98m\u001b[39m \u001b[0m\u001b[9;1H\u001b[0m\u001b[0m\u2502\u001b[38;2;98;98;98mtranscript \u2524\u001b[38;2;60;191;154m                                                                     \u2588\u2588\u2588\u2588\u2588\u2588\u2588        \u001b[38;2;98;98;98m\u2502\u001b[39m\u2502\u001b[0m \u001b[10;1H\u001b[0m\u001b[0m\u2502\u001b[38;2;98;98;98m      body \u2524\u001b[38;2;240;228;66m                                                                           \u2588\u2588\u2588\u2588\u2588    \u001b[38;2;98;98;98m\u2502\u001b[39m\u2502\u001b[0m\u001b[38;2;98;98;98m\u001b[39m\u001b[38;2;98;98;98m\u001b[39m \u001b[0m\u001b[11;1H\u001b[0m\u001b[0m\u2502\u001b[38;2;98;98;98m     write \u2524\u001b[38;2;143;168;255m                                                                               \u2588\u2588\u2588  \u001b[38;2;98;98;98m\u2502\u001b[39m\u2502\u001b[0m \u001b[12;1H\u001b[0m\u001b[0m\u2502\u001b[38;2;98;98;98m    prompt \u2524\u001b[38;2;240;122;60m                                                                                 \u2588\u2588 \u001b[38;2;98;98;98m\u2502\u001b[39m\u2502\u001b[0m\u001b[38;2;230;159;0m\u001b[38;2;86;180;233m\u001b[38;2;60;191;154m\u001b[38;2;230;159;0m\u001b[38;2;207;207;207m\u001b[39m\u001b[38;2;138;138;138m\u001b[38;2;232;168;124m\u001b[38;2;138;138;138m\u001b[39m \u001b[0m\u001b[13;1H\u001b[0m\u001b[0m\u2502\u001b[38;2;98;98;98m    chrome \u2524\u001b[38;2;228;163;196m                                                                                  \u2588\u2588\u001b[38;2;98;98;98m\u2502\u001b[39m\u2502\u001b[0m\u001b[38;2;230;159;0m\u001b[38;2;86;180;233m\u001b[38;2;60;191;154m\u001b[38;2;230;159;0m\u001b[38;2;207;207;207m\u001b[39m\u001b[38;2;138;138;138m\u001b[39m\u001b[38;2;138;138;138m\u001b[39m \u001b[0m\u001b[14;1H\u001b[0m\u001b[0m\u2502\u001b[38;2;98;98;98m  measured \u2524\u001b[38;2;207;207;207m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u