[3.371504, "o", "\u001b[?25l\u001b[H\u001b[38;2;98;98;98mdocker-tui\u001b[39m  \u001b[38;2;98;98;98m/workspaces/tui-kit/examples/docker/bin/docker-json\u001b[39m  \u001b[38;2;98;98;98m17:14:04\u001b[39m                                               \r\r\n                                                                                                                        \r\r\n                                                                                                                        \r\r\n                                                                                                                        \r\r\n                                                                                                                        \r\r\n                                                                                                                        \r\r\n                                                                                                                        \r\r\n                                                                                                                        \r\r\n                                                                                                                        \r\r\n                    ##        .                                                                                         \r\r\n              ## ## ##       ==              \u2584\u2584\u2584\u2584\u2584                         \u2584\u2584                                           \r\r\n           ## ## ## ##      ===              \u2588\u2588\u2580\u2580\u2580\u2588\u2588                       \u2588\u2588                                           \r\r\n       /\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\\___/ ===            \u2588\u2588    \u2588\u2588   \u2584\u2588\u2588\u2588\u2588\u2584    \u2584\u2588\u2588\u2588\u2588\u2588\u2584  \u2588\u2588 \u2584\u2588\u2588\u2580    \u2584\u2588\u2588\u2588\u2588\u2584    \u2588\u2588\u2584\u2588\u2588\u2588\u2588                 \r\r\n  ~~~ {~~ ~~~~ ~~~ ~~~~ ~~ ~ /  ===- ~~~     \u2588\u2588    \u2588\u2588  \u2588\u2588\u2580  \u2580\u2588\u2588  \u2588\u2588\u2580    \u2580  \u2588\u2588\u2584\u2588\u2588     \u2588\u2588\u2584\u2584\u2584\u2584\u2588\u2588   \u2588\u2588\u2580                     \r\r\n       \\______ o          __/                \u2588\u2588    \u2588\u2588  \u2588\u2588    \u2588\u2588  \u2588\u2588        \u2588\u2588\u2580\u2588\u2588\u2584    \u2588\u2588\u2580\u2580\u2580\u2580\u2580\u2580   \u2588\u2588                      \r\r\n         \\    \\        __/                   \u2588\u2588\u2584\u2584\u2584\u2588\u2588   \u2580\u2588\u2588\u2584\u2584\u2588\u2588\u2580  \u2580\u2588\u2588\u2584\u2584\u2584\u2584\u2588  \u2588\u2588  \u2580\u2588\u2584   \u2580\u2588\u2588\u2584\u2584\u2584\u2584\u2588   \u2588\u2588                      \r\r\n          \\____\\______/                      \u2580\u2580\u2580\u2580\u2580       \u2580\u2580\u2580\u2580      \u2580\u2580\u2580\u2580\u2580   \u2580\u2580   \u2580\u2580\u2580    \u2580\u2580\u2580\u2580\u2580    \u2580\u2580                      \r\r\n                                                                                                                        \r\r\n\u001b[38;2;138;138;138m\u250c\u001b[38;2;232;168;124m docker-tui \u00b7 engine 29.4.1 \u00b7 10 containers \u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[39m\r\r\n\u001b[38;2;138;138;138m\u2502\u001b[39m                                                                                                                      \u001b[38;2;138;138;138m\u2502\u001b[39m\r\r\n\u2502\u001b[38;2;138;138;138m\u250c\u001b[38;2;232;168;124m RUNNING \u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[39m\u2502\r\r\n\u2502\u001b[38;2;138;138;138m\u2502\u001b[38;2;98;98;98m4 running   CPU 4% \u00b7 MEM 3%\u001b[39m                                                                                         \u001b[38;2;138;138;138m\u2502\u001b[39m\u2502\r\r\n\u2502\u2502                                                                                                                    \u2502\u2502\r\r\n\u2502\u2502\u001b[38;2;98;98;98mNAME                    \u001b[39m  \u001b[38;2;98;98;98mCPU              \u001b[39m  \u001b[38;2;98;98;98mMEM              \u001b[39m  \u001b[38;2;98;98;98mUSAGE             \u001b[39m                                  \u2502\u2502\r\r\n"]
[3.371605, "o", "\u2502\u2502\u001b[38;2;135;184;108m\u25cf dtui-cfg              \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.0%    \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.1%    \u001b[39m  \u001b[38;2;212;212;212m9.395MiB / 7.75GiB\u001b[39m                                  \u2502\u2502\r\r\n\u2502\u2502\u001b[38;2;135;184;108m\u25cf dtui-load             \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.0%    \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.0%    \u001b[39m  \u001b[38;2;212;212;212m1.25MiB / 7.75GiB \u001b[39m                                  \u2502\u2502\r\r\n\u2502\u2502\u001b[38;2;135;184;108m\u25cf dtui-web              \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.0%    \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.1%    \u001b[39m  \u001b[38;2;212;212;212m9.391MiB / 7.75GiB\u001b[39m                                  \u2502\u2502\r\r\n\u2502\u2502\u001b[38;2;135;184;108m\u25cf reverent_proskuriakova\u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 3.6%    \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 2.8%    \u001b[39m  \u001b[38;2;212;212;212m221.8MiB / 7.75GiB\u001b[39m                                  \u2502\u2502\r\r\n\u2502\u001b[38;2;138;138;138m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[39m\u2502\r\r\n\u2502                                                                                                                      \u2502\r\r\n\u2502\u001b[38;2;98;98;98mbeautiful_booth\u001b[39m  \u001b[38;2;98;98;98mcondescending_cohen\u001b[39m  \u001b[38;2;98;98;98mdazzling_wozniak\u001b[39m  \u001b[38;2;98;98;98mdistracted_davinci\u001b[39m  \u001b[38;2;98;98;98mdtui-quiet\u001b[39m  \u001b[38;2;98;98;98mfrosty_hodgkin\u001b[39m                \u2502\r\r\n\u001b[38;2;138;138;138m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[39m\r\r\n\u276f /container stats dtui-load                                                                                            \r\r\n                                                                                                                        \u001b[?25l\u001b[33;29H\u001b[?25h"]
