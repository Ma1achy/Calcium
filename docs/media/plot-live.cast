[8.507752, "o", "\u001b[?25l\u001b[9;1H\u001b[0m  \u001b[38;2;98;98;98m\u2502\u001b[0m \u2502\u001b[38;2;98;98;98m50 \u2524\u001b[39m                                                                                  \u001b[38;2;98;98;98m\u2502\u001b[38;2;230;159;0m \u2588 p50\u001b[39m\u2502 \u001b[10;1H\u001b[0m  \u001b[38;2;98;98;98m\u2502\u001b[0m \u2502\u001b[38;2;98;98;98m   \u2502\u001b[38;2;86;180;233m\u2576\u2500\u256e\u001b[39m                                                                               \u001b[38;2;98;98;98m\u2502\u001b[38;2;86;180;233m \u2588 p99\u001b[39m\u2502 \u001b[11;1H\u001b[0m  \u001b[38;2;98;98;98m\u2502\u001b[0m \u2502\u001b[38;2;98;98;98m   \u2502\u001b[39m  \u001b[38;2;86;180;233m\u2570\u2500\u2500\u256e\u001b[39m                                                                  \u001b[38;2;86;180;233m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2574\u001b[38;2;98;98;98m\u2502\u001b[39m      \u2502 \u001b[12;1H\u001b[0m  \u001b[38;2;98;98;98m\u2502\u001b[0m \u2502\u001b[38;2;98;98;98m40 \u2524\u001b[39m     \u001b[38;2;86;180;233m\u2570\u2500\u2500\u2500\u256e\u001b[39m                                  \u001b[38;2;86;180;233m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[39m  \u001b[38;2;86;180;233m\u256d\u2500\u2500\u2500\u256f\u001b[39m         \u001b[38;2;98;98;98m\u2502\u001b[39m      \u2502 \u001b[13;1H\u001b[0m  \u001b[38;2;98;98;98m\u2502\u001b[0m \u2502\u001b[38;2;98;98;98m   \u2502\u001b[39m         \u001b[38;2;86;180;233m\u2570\u2500\u2500\u256e\u001b[39m                           \u001b[38;2;86;180;233m\u256d\u2500\u2500\u2500\u256f\u001b[39m                    \u001b[38;2;86;180;233m\u2570\u2500\u2500\u256f\u001b[39m             \u001b[38;2;98;98;98m\u2502\u001b[39m      \u2502 \u001b[14;1H\u001b[0m  \u001b[38;2;98;98;98m\u2502\u001b[0m \u2502\u001b[38;2;98;98;98m30 \u2524\u001b[39m            \u001b[38;2;86;180;233m