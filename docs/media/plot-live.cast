[4.843496, "o", "\u001b[?25l\u001b[1;1H\u001b[0m\u001b[38;2;212;212;212mplots-tui\u001b[39m  \u001b[38;2;98;98;98m/workspace/examples/plots/bin/plots\u001b[39m                                              \u001b[38;2;98;98;98m11:24:54\u001b[39m\u001b[15;1H\u001b[0m\u001b[38;2;230;159;0m\u2588\u001b[38;2;86;180;233m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;240;228;66m blend \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;230;159;0m\u2588\u001b[38;2;207;207;207m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[39m \u2502\u001b[38;2;98;98;98m \u2502\u001b[39m                                      \u001b[38;2;127;174;207m\u256d\u256e\u001b[39m \u001b[38;2;98;98;98m\u251c 75\u001b[39m\u2502 \u001b[16;1H\u001b[0m\u001b[38;2;230;159;0m\u2588\u001b[38;2;86;180;233m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;240;228;66m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;230;159;0m\u2588\u001b[38;2;207;207;207m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[39m \u2502\u001b[38;2;98;98;98m \u2502\u001b[39m                      \u001b[38;2;127;174;207m\u256d\u256e\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u2570\u2574\u001b[38;2;98;98;98m\u2523 \u001b[1m\u001b[38;2;127;174;207m68\u001b[39m\u001b[22m\u2502 \u001b[17;1H\u001b[0m\u001b[38;2;230;159;0m paint \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;207;207;207m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[39m \u2502\u001b[38;2;98;98;98m \u2502\u001b[39m             \u001b[38;2;127;174;207m\u256d\u2500\u2500\u250