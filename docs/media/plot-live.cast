[3.285692, "o", "\u001b[?25l\u001b[15;1H\u001b[0m\u001b[38;2;230;159;0m\u2588\u001b[38;2;86;180;233m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;240;228;66m blend \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;230;159;0m\u2588\u001b[38;2;207;207;207m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[39m \u2502\u001b[38;2;98;98;98m \u2502\u001b[39m                                         \u001b[38;2;98;98;98m\u251c 80\u001b[39m\u2502 \u001b[16;1H\u001b[0m\u001b[38;2;230;159;0m\u2588\u001b[38;2;86;180;233m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;240;228;66m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;230;159;0m\u2588\u001b[38;2;207;207;207m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[39m \u2502\u001b[38;2;98;98;98m \u2502\u001b[39m                                         \u001b[38;2;98;98;98m\u2502   \u001b[39m\u2502 \u001b[17;1H\u001b[0m\u001b[38;2;230;159;0m paint \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;207;207;207m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[39m \u2502\u001b[38;2;98;98;98m \u2502\u001b[39m                                  \u001b[38;2;127;174;207m\u256d\u2500\u256e\u256d\u2500\u2500\u2574\u001b[38;2;98;98;98m\u2523 \u001b[1m\u001b[38;2;127;174;207m62\u001b[39m\u001b[22m\u2502 \u001b[18;1H\u001b[0m\u001b[38;2;143;168;255m\u2588\u001b[38;2;240;122;60m measure \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;228;163;196m wrap \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;143;168;255m\u2588\u001b[38;2;207;207;207m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[39m \u2502\u001b[38;2;98;98;98m \u2502\u001b[39m                     \u001b[38;2;127;174;207m\u256d\u2500\u2500\u2500\u2500\u256e\u001b[39m \u001b[38;2;127;174;207m\u256d\u2500\u2500\u2500\u2500\u2500\u256f\u001b[39m \u001b[38;2;127;174;207m\u2570\u256f\u001b[39m   \u001b[38;2;98;98;98m\u2502   \u001b[39m\u2502 \u001b[19;1H\u001b[0m\u001b[38;2;143;168;255m\u2588\u001b[38;2;240;122;60m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;228;163;196m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;143;168;255m\u2588\u001b[38;2;207;207;207m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[39m \u2502\u001b[38;2;98;98;98m \u2502\u001b[39m               \u001b[38;2;127;174;207m\u256d\u2500\u2500\u2500\u2500\u2500\u256f\u001b[39m    \u001b[38;2;127;174;207m\u2570\u2500\u256f\u001b[39m            \u001b[38;2;98;98;98m\u2502   \u001b[39m\u2502 \u001b[20;1H\u001b[0m\u001b[38;2;143;168;255m\u2588\u001b[38;2;240;122;60m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;228;163;196m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;143;168;255m\u2588\u001b[38;2;207;207;207m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[39m \u2502\u001b[38;2;98;98;98m \u2502\u001b[39m          \u001b[38;2;127;174;207m\u256d\u2500\u2500\u2500\u2500\u256f\u001b[39m                         \u001b[38;2;98;98;98m\u251c 40\u001b[39m\u2502 \u001b[21;1H\u001b[0m\u001b[38;2;143;168;255m\u2588\u001b[38;2;240;122;60m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[38;2;228;163;196m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u258