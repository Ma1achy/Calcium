168;124m docker-tui \u00b7 engine 29.4.1 \u00b7 10 containers \u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[39m\r\r\n\u001b[38;2;138;138;138m\u2502\u001b[39m                                                                              \u001b[38;2;138;138;138m\u2502\u001b[39m\r\r\n\u2502\u001b[38;2;138;138;138m\u250c\u001b[38;2;232;168;124m RUNNING \u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[39m\u2502\r\r\n\u2502\u001b[38;2;138;138;138m\u2502\u001b[38;2;98;98;98m4 running   CPU 2% \u00b7 MEM 3%\u001b[39m                                                 \u001b[38;2;138;138;138m\u2502\u001b[39m\u2502\r\r\n\u2502\u2502                                                                            \u2502\u2502\r\r\n\u2502\u2502\u001b[38;2;98;98;98mNAME                    \u001b[39m  \u001b[38;2;98;98;98mCPU              \u001b[39m  \u001b[38;2;98;98;98mMEM              \u001b[39m              \u2502\u2502\r\r\n\u2502\u2502\u001b[38;2;135;184;108m\u25cf dtui-cfg              \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.0%    \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.1%    \u001b[39m              \u2502\u2502\r\r\n\u2502\u2502\u001b[38;2;135;184;108m\u25cf dtui-load             \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.0%    \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.0%    \u001b[39m              \u2502\u2502\r\r\n\u2502\u2502\u001b[38;2;135;184;108m\u25cf dtui-web              \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.0%    \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 0.1%    \u001b[39m              \u2502\u2502\r\r\n\u2502\u2502\u001b[38;2;135;184;108m\u25cf reverent_proskuriakova\u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 2.2%    \u001b[39m  \u001b[38;2;135;184;108m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591 2.9%    \u001b[39m              \u2502\u2502\r\r\n\u2502\u001b[38;2;138;138;138m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[39m\u2502\r\r\n\u2502                                                                              \u2502\r\r\n\u2502\u001b[38;2;98;98;98mbeautiful_booth\u001b[39m  \u001b[38;2;98;98;98mcondescending_cohen\u001b[39m  \u001b[38;2;98;98;98mdazzling_wozniak\u001b[39m  \u001b[38;2;98;98;98mdistracted_davinci\u001b[39m    \u2502\r\r\n\u2502\u001b[38;2;98;98;98mdtui-quiet\u001b[39m  \u001b[38;2;98;98;98mfrosty_hodgkin\u001b[39m                                                    \u2502\r\r\n\u001b[38;2;138;138;138m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500