{
  "compilerOptions": {
    "target": "ES2022",
    // ESNext.Disposable for `Disposable` and `Symbol.dispose`. Six specs
    // (C01, C03, C13, C15, C16, C19) return one and none defines it; taking the
    // language's type means no module owns it and `using` works.
    "lib": ["ES2022", "ESNext.Disposable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // This config type-checks everything: src, the six test tiers, and the
  // enforcement tools. Emit settings live in tsconfig.build.json, which is
  // scoped to `src` — `rootDir: "src"` here would reject every test file.
  "include": ["src", "test", "tools"]
}
